<Project Sdk="Microsoft.NET.Sdk">
  <!-- xshard-cli.exe: console front end for scripts. Same services as the GUI, no UI libraries.
       Release publish: self-contained single file, trimmed (TrimMode=partial: framework only, XShard.Core kept whole). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>xshard-cli</AssemblyName><RootNamespace>XShard.Cli</RootNamespace>
    <Version>0.1.9</Version><AssemblyVersion>0.1.9.0</AssemblyVersion><FileVersion>0.1.9.0</FileVersion>
    <Authors>Sven Klocke</Authors><Company>sksdesign</Company><Product>X-Shard</Product><Copyright>Copyright © 2026 Sven Klocke</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ApplicationIcon>../XShard/Assets/app-icon.ico</ApplicationIcon>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed><TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../XShard.Core/XShard.Core.csproj" />
  </ItemGroup>
</Project>
