<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral services, models, parsers and reports shared by the GUI (X-Shard.exe), the CLI (xshard-cli.exe) and the verification harnesses. No UI dependencies. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XShard.Core</AssemblyName><RootNamespace>XShard</RootNamespace>
    <Version>0.1.9</Version><AssemblyVersion>0.1.9.0</AssemblyVersion><FileVersion>0.1.9.0</FileVersion>
    <Authors>Sven Klocke</Authors><Company>sksdesign</Company><Product>X-Shard</Product><Copyright>Copyright © 2026 Sven Klocke</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../Localization/en.xml" LogicalName="XShard.Localization.en.xml" />
  </ItemGroup>
</Project>
